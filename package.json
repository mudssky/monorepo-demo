{
  "name": "monorepo-demo",
  "private": true,
  "scripts": {
    "admin-dev": "turbo run do-admin-dev",
    "build": "turbo run build --filter=!docs",
    "dev": "turbo run dev --filter=web",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format-and-lint": "biome check .",
    "format-and-lint:fix": "biome check . --write",
    "lint": "turbo run lint",
    "publish-packages": "turbo run lint test && changeset version && changeset publish",
    "server:dev": "turbo run dev --filter=server",
    "test": "turbo run test",
    "turbo:upgrade": "pnpm dlx @turbo/codemod migrate",
    "prepare": "husky"
  },
  "dependencies": {
    "@mudssky/jsutils": "^1.35.0",
    "dayjs": "^1.11.20",
    "lodash-es": "^4.18.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@changesets/cli": "^2.31.0",
    "@mudssky/prettier-config-custom": "workspace:*",
    "@mudssky/tsconfig": "workspace:*",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.7.0",
    "@typescript/native-preview": "7.0.0-dev.20260513.1",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "rimraf": "^6.1.3",
    "turbo": "^2.9.12"
  },
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a"
}
